<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fr3">
  <xacro:macro name="hand" params="arm_id:='fr3' prefix:='left_'">

    <group name="${prefix}${arm_id}_hand">
      <link name="${prefix}${arm_id}_hand"/>
      <link name="${prefix}${arm_id}_leftfinger"/>
      <link name="${prefix}${arm_id}_rightfinger"/>
      <joint name="${prefix}${arm_id}_finger_joint1"/>
      <passive_joint name="${prefix}${arm_id}_finger_joint2"/>
    </group>
    <disable_collisions link1="${prefix}${arm_id}_hand" link2="${prefix}${arm_id}_leftfinger" reason="Adjacent"/>
    <disable_collisions link1="${prefix}${arm_id}_hand" link2="${prefix}${arm_id}_rightfinger" reason="Adjacent"/>
    <disable_collisions link1="${prefix}${arm_id}_leftfinger" link2="${prefix}${arm_id}_rightfinger" reason="Default"/>
  </xacro:macro>
</robot>
