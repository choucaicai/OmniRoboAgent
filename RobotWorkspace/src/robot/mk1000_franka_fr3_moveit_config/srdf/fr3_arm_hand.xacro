<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fr3">
  <xacro:macro name="fr3_arm_hand" params="arm_id:='fr3' prefix:='left_'  ">

    <group_state name="open" group="${prefix}${arm_id}_hand">
      <joint name="${prefix}${arm_id}_finger_joint1" value="0.035"/>
      <joint name="${prefix}${arm_id}_finger_joint2" value="0.035"/>
    </group_state>

    <group_state name="close" group="${prefix}${arm_id}_hand">
      <joint name="${prefix}${arm_id}_finger_joint1" value="0"/>
      <joint name="${prefix}${arm_id}_finger_joint2" value="0"/>
    </group_state>
    
    <end_effector name="${prefix}${arm_id}_hand_tcp" parent_link="${prefix}${arm_id}_hand_tcp" group="${prefix}${arm_id}_hand" parent_group="${prefix}${arm_id}_manipulator"/>
    <end_effector name="${prefix}${arm_id}_hand" parent_link="${prefix}${arm_id}_link8" group="${prefix}${arm_id}_hand" parent_group="${prefix}${arm_id}_arm"/>
    <disable_collisions link1="${prefix}${arm_id}_hand" link2="${prefix}${arm_id}_link3" reason="Never"/>
    <disable_collisions link1="${prefix}${arm_id}_hand" link2="${prefix}${arm_id}_link4" reason="Never"/>
    <disable_collisions link1="${prefix}${arm_id}_hand" link2="${prefix}${arm_id}_link6" reason="Never"/>
    <disable_collisions link1="${prefix}${arm_id}_hand" link2="${prefix}${arm_id}_link7" reason="Adjacent"/>
    <disable_collisions link1="${prefix}${arm_id}_hand" link2="${prefix}${arm_id}_link8" reason="Adjacent"/>
    <disable_collisions link1="${prefix}${arm_id}_leftfinger" link2="${prefix}${arm_id}_link3" reason="Never"/>
    <disable_collisions link1="${prefix}${arm_id}_leftfinger" link2="${prefix}${arm_id}_link4" reason="Never"/>
    <disable_collisions link1="${prefix}${arm_id}_leftfinger" link2="${prefix}${arm_id}_link6" reason="Never"/>
    <disable_collisions link1="${prefix}${arm_id}_leftfinger" link2="${prefix}${arm_id}_link7" reason="Never"/>
    <disable_collisions link1="${prefix}${arm_id}_leftfinger" link2="${prefix}${arm_id}_link8" reason="Never"/>
    <disable_collisions link1="${prefix}${arm_id}_link3" link2="${prefix}${arm_id}_rightfinger" reason="Never"/>
    <disable_collisions link1="${prefix}${arm_id}_link4" link2="${prefix}${arm_id}_rightfinger" reason="Never"/>
    <disable_collisions link1="${prefix}${arm_id}_link6" link2="${prefix}${arm_id}_rightfinger" reason="Never"/>
    <disable_collisions link1="${prefix}${arm_id}_link7" link2="${prefix}${arm_id}_rightfinger" reason="Never"/>
    <disable_collisions link1="${prefix}${arm_id}_link8" link2="${prefix}${arm_id}_rightfinger" reason="Never"/>
  </xacro:macro>
</robot>
