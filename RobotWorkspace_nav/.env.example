# Recommended Go2 client settings. Port 5801 is StreamVLN; 5802 is AwareVLN.
VLN_SERVER_URL=http://127.0.0.1:5802/eval_vln
VLN_SESSION_ID=go2-01
VLN_INSTRUCTION="Exit the room and stop beside the red chair."

